# Copy this file to .env for local development.
# In production on Databricks Apps, LAKEBASE_URL is injected from the
# "database/lakebase-url" secret via app.yaml - do NOT put a real secret
# value in this file or commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Optional - unauthenticated GitHub requests work fine for this lab's data
# volumes (60 req/hr). Set these only if you created a GitHub PAT via
# setup_secrets.py.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_SECRET_SCOPE=github
GITHUB_SECRET_KEY=token

# Table names (must match the notebooks + Synced Table configuration)
WATCHLIST_TABLE_NAME=watchlist
INSIGHTS_TABLE_NAME=github_repo_insights_gold
